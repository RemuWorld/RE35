    "configuration": {
      "title": "RE35",
      "properties": {
        "re35.helperPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute ce_stdio override. Empty uses the helper included in a platform VSIX, when available."
        },
        "re35.luaRuntime": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute Lua 5.1 ABI runtime override. Empty uses the runtime included in a platform VSIX, when available."
        },
        "re35.corePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute RE35 Lua directory override. Empty uses the packaged core or ../../lua in a development checkout."
        },
        "re35.projectRoots": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Local mapping from portable project IDs to exact file workspace-folder URIs. Required when more than one folder is open."
        },
        "re35.configBase": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Explicit absolute local base for portable project roots using config. Empty leaves that base unavailable."
        },
        "re35.homeBase": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Explicit absolute local base for portable project roots using home. Empty leaves that base unavailable."
        },
        "re35.toolOverrides": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Step execution timeout in milliseconds; zero disables it. Expiry requests cancellation and escalation after grace.",
                "maximum": 86400000
              },
              "cancel_grace_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Cancellation grace in milliseconds (default 2000). Scoped helper requires at least 1 ms internally.",
                "maximum": 60000
              }
            }
          },
          "description": "Local command/args/cwd, per-step timeout_ms and cancel_grace_ms. Step args/cwd take precedence. No implicit shell, timeout or executable installation."
        },
        "re35.processHelper": {
          "type": "string",
          "description": "Optional absolute process-scope helper override. Empty uses a bundled helper when available, otherwise direct-child scope. A configured unavailable helper is refused.",
          "scope": "machine",
          "default": ""
        },
        "re35.projectSearch": {
          "type": "object",
          "scope": "machine",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "description": "Existing ripgrep executable name or absolute local path. Selected provider never falls back."
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "results": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000
                },
                "max_file_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4194304
                },
                "read_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 67108864
                },
                "output_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16777216
                },
                "milliseconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15000
                }
              }
            }
          },
          "description": "Local saved-file search executable and limits. Provider is selected in the portable profile; builtin has smaller shared ceilings."
        },
        "re35.presentation": {
          "type": "object",
          "default": {
            "version": 1,
            "presets": {}
          },
          "scope": "window",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "integer",
              "enum": [
                1
              ]
            },
            "selected": {
              "type": "string"
            },
            "presets": {
              "type": "object"
            }
          },
          "description": "Shared appearance preferences. An applied portable profile overrides this collection. Native UI applies optional information; geometry, icons, decoration and colors report native fallbacks. No executable styling."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "re35.execute",
          "when": "false"
        }
      ]
    },
