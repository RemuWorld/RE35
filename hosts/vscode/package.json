      {
        "command": "re35.cancelRecipe",
        "title": "RE35: Cancel Running Recipe"
      },
      {
        "command": "re35.taskResults",
        "title": "RE35: Recipe Results"
      },
      {
        "command": "re35.searchProject",
        "title": "RE35: Search Project Text"
