      {
        "command": "re35.contextual.stop",
        "title": "RE35: Return to Ordinary Typing"
      },
      {
        "command": "re35.inputHistory",
        "title": "RE35: Inspect Input History"
      },
      {
        "command": "re35.clearInputHistory",
        "title": "RE35: Clear Input History"
      },
      {
        "command": "re35.open",
        "title": "RE35: Open Command Environment"
      },
      {
        "command": "re35.execute",
        "title": "RE35: Execute Semantic Command"
      },
      {
        "command": "re35.searchDocument",
        "title": "RE35: Search Current Document"
      },
      {
        "command": "re35.replaceLiteral",
        "title": "RE35: Preview Literal Replacement"
      },
      {
        "command": "re35.editingGuide",
        "title": "RE35: Editing Command Guide"
      },
      {
        "command": "re35.results",
        "title": "RE35: Document Results"
      },
      {
        "command": "re35.loadProfile",
        "title": "RE35: Load Portable Profile"
      },
      {
        "command": "re35.selectProject",
        "title": "RE35: Select Project Context"
      },
      {
        "command": "re35.projectContext",
        "title": "RE35: Inspect Project Context"
      },
      {
        "command": "re35.runRecipe",
