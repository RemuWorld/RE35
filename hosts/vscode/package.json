{
  "name": "re35-desktop",
  "displayName": "RE35 Command Environment",
  "description": "User-owned commands, reusable compositions and connected results for VS Code.",
  "version": "0.5.0",
  "publisher": "RemuWorld",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onCommand:re35.open",
    "onCommand:re35.execute",
    "onCommand:re35.searchDocument",
    "onCommand:re35.replaceLiteral",
    "onCommand:re35.editingGuide",
    "onCommand:re35.results",
    "onCommand:re35.loadProfile",
    "onCommand:re35.selectProject",
    "onCommand:re35.projectContext",
    "onCommand:re35.runRecipe",
    "onCommand:re35.tasks",
    "onCommand:re35.cancelRecipe",
    "onCommand:re35.taskResults",
    "onCommand:re35.searchProject",
    "onCommand:re35.projectSearchResults",
    "onCommand:re35.cancelProjectSearch",
    "onCommand:re35.taskRecovery",
    "onCommand:re35.presentationPresets",
    "onCommand:re35.exportPresentation",
    "onCommand:re35.importPresentation",
    "onCommand:re35.cancelUserCommand",
    "onCommand:re35.runUserCommand",
    "onCommand:re35.userCommandResults",
    "onCommand:re35.userCommands",
    "onCommand:re35.inputRules",
    "onCommand:re35.input.pause",
    "onCommand:re35.input.resume",
    "onCommand:re35.commands",
    "onCommand:re35.newSession",
    "onCommand:re35.inputHistory",
    "onCommand:re35.clearInputHistory",
    "onCommand:re35.commandContexts",
    "onCommand:re35.contextual.activate",
    "onCommand:re35.contextual.stop"
  ],
